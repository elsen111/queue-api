# --- App ---
APP_PORT=8080

# --- Database ---
POSTGRES_DB=queue_api
POSTGRES_USER=queue_user
POSTGRES_PASSWORD=your_strong_postgres_password
POSTGRES_PORT=5432

# --- JWT ---
# Base64-encoded signing key, at least 32 bytes decoded (required for HS256).
# Generate one with: openssl rand -base64 32
JWT_SECRET=replace_with_a_base64_encoded_secret_at_least_32_bytes
JWT_EXPIRATION_MS=3600000

# --- Default admin account ---
# Seeded into the "admins" table on first startup if no admin exists yet.
# Change these before deploying anywhere beyond local dev.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# --- Rate limiting ---
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL=30
RATE_LIMIT_DURATION=60